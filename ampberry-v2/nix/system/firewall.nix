# Firewall, fully declared in the flake: an nftables ruleset generated by Nix and loaded by a
# oneshot unit. Policy drop; only the LAN may reach SSH, the web UI, mDNS and AirPlay 2.
# IPv6 stays closed except neighbour discovery (avahi is IPv4-only, see Ampberry::System).
# The onboarding hotspot (NetworkManager shared mode on wlan0, 10.42.0.0/24) needs DHCP/DNS/UI/SSH
# on wlan0; those rules are static too — they are inert while wlan0 is a Wi-Fi client because
# nothing listens on 53/67 then. Changing LAN: edit `network` in flake.nix, switch, done.
{
  lib,
  pkgs,
  ampberry,
  ...
}:
let
  net = ampberry.network;
  nft = "${pkgs.nftables}/bin/nft";
  ruleset = pkgs.writeText "ampberry.nft" ''
    # Ampberry firewall — generated by the Nix flake (nix/system/firewall.nix)
    table inet ampberry
    delete table inet ampberry
    table inet ampberry {
      set lan4 {
        type ipv4_addr
        flags interval
        elements = { ${lib.concatStringsSep ", " net.lanCidrs} }
      }

      chain input {
        type filter hook input priority filter; policy drop;
        ct state invalid drop
        ct state { established, related } accept
        iif "lo" accept

        # IPv6: no services, but the stack needs neighbour discovery / router advertisements
        meta l4proto ipv6-icmp accept
        # ping and ICMP errors from the LAN only
        ip saddr @lan4 icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept

        # LAN only: SSH, web UI, AirPlay 2 RTSP (7000), negotiated AirPlay 2 ports
        ip saddr @lan4 tcp dport { 22, 80, 7000, 32768-60999 } accept
        # LAN only: mDNS, nqptp (PTP 319/320), negotiated AirPlay 2 ports
        ip saddr @lan4 udp dport { 5353, 319, 320, 32768-60999 } accept

        # Onboarding hotspot on ${net.wifiInterface}: DHCP DISCOVER arrives from 0.0.0.0 (no source filter),
        # DNS + captive web UI + SSH only from the hotspot subnet
        iifname "${net.wifiInterface}" udp dport { 67, 53 } accept
        iifname "${net.wifiInterface}" ip saddr ${net.hotspotCidr} tcp dport { 22, 53, 80 } accept

        counter comment "dropped"
      }

      chain forward {
        # the speaker never routes traffic (also blocks NetworkManager's shared-mode NAT)
        type filter hook forward priority filter; policy drop;
      }

      chain output {
        type filter hook output priority filter; policy accept;
      }
    }
  '';
in
{
  config.systemd.services.ampberry-firewall = {
    description = "Ampberry firewall (nftables: LAN-only AirPlay 2, hotspot onboarding)";
    documentation = [ "file:${ruleset}" ];
    wantedBy = [ "multi-user.target" ];
    wants = [ "network-pre.target" ];
    before = [ "network-pre.target" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = "${nft} -f ${ruleset}";
      ExecReload = "${nft} -f ${ruleset}";
      ExecStop = "${nft} delete table inet ampberry";
    };
  };
}
