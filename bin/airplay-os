#!/usr/bin/env ruby
# frozen_string_literal: true

# airplay-os — root-side tooling for the AirPlay OS appliance.
# The web UI never calls this directly: it talks to the control socket (`control handle`, started
# by systemd socket activation as root), which runs only allow-listed actions.

require "json"
require "optparse"

# systemd units often run without LANG; treat files as UTF-8 regardless
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "airplay_os"

USAGE = <<~USAGE
  usage: airplay-os <command> [subcommand] [options]

    provision [--dry-run] [--verbose] [--skip step,...]   runtime provisioning (after the flake is active)
    settings show|schema|render                           effective settings / schema / rendered conf
    settings apply                                        STDIN: {"settings": {...}} → write conf, restart
    wifi scan|status|ensure
    wifi connect                                          STDIN: {"ssid":"...","psk":"..."}
    wifi hotspot on|off
    system clean-reboot                                   STDIN (optional): {"reset_settings":true}
    system minimize | config-txt | avahi | ui-secret
    action list | run <id>                                the allow-list the UI uses (STDIN: params JSON)
    control handle                                        one request on STDIN (systemd socket activation)
    metadata daemon                                       shairport-sync pipe → /run/airplay-os/now-playing.json
    log aggregate                                         journal → /var/log/airplay-os.log (the UI backdrop)
    redeploy start|run|status [--update-shairport VER]    re-apply the flake (/opt/airplay-os) + provision, in the background
                                                          (--update-shairport: that release on top of the flake instead)
    health [--json]                                       one health line (cpu · mem · temp; DEGRADED · … when unwell) → journal / live log
    updates check|status                                  shairport-sync: running vs latest release (cached)
    version | help

  Data commands print JSON on STDOUT. Commands that change the system must run as root.
USAGE

def usage(code = 0, msg = nil)
  warn "airplay-os: #{msg}\n" if msg
  warn USAGE
  exit code
end

def need_root!
  return if Process.uid.zero? || AirPlayOS::Run.dry_run || ENV["AIRPLAY_OS_ROOT"]

  raise AirPlayOS::Error, "this command must run as root"
end

def stdin_json(required: true)
  if $stdin.tty?
    raise AirPlayOS::Error, "expected JSON on STDIN" if required

    return {}
  end
  text = $stdin.read.to_s
  return {} if text.strip.empty? && !required

  data = JSON.parse(text)
  raise AirPlayOS::Error, "JSON on STDIN must be an object" unless data.is_a?(Hash)

  data
rescue JSON::ParserError => e
  raise AirPlayOS::Error, "invalid JSON on STDIN: #{e.message.lines.first&.strip}"
end

def out_json(data)
  puts JSON.pretty_generate(data)
  0
end

def parse_opts(args, &block)
  OptionParser.new(&block).parse!(args)
rescue OptionParser::ParseError => e
  usage(2, e.message)
end

def cmd_provision(args)
  opts = { skip: [] }
  parse_opts(args) do |o|
    o.on("--dry-run") { AirPlayOS::Run.dry_run = true }
    o.on("--verbose", "-v") { opts[:verbose] = true }
    o.on("--skip LIST") { |v| opts[:skip] = v.split(",") }
  end
  need_root!
  AirPlayOS::Log.init("provision", verbose: opts[:verbose] || false)
  r = AirPlayOS::Provision.run_all(skip: opts[:skip])
  AirPlayOS::Log.info("summary: #{r.map { |k, v| "#{k}=#{v}" }.join(', ')}")
  0
end

def cmd_settings(args)
  sub = args.shift or usage(2, "settings needs show|schema|render|apply")
  case sub
  when "show" then out_json(AirPlayOS::Config.effective_settings)
  when "schema" then out_json(AirPlayOS::Config.settings_schema)
  when "render"
    print AirPlayOS::Settings.render_conf(AirPlayOS::Config.effective_settings)
    0
  when "apply"
    need_root!
    AirPlayOS::Log.init("settings")
    input = stdin_json(required: false)
    settings = input.key?("settings") ? input["settings"] : input
    r = AirPlayOS::Actions.run_action("settings-apply", { "settings" => settings })
    r.delete(:after)
    out_json(r)
    r["ok"] ? 0 : 1
  else usage(2, "unknown settings subcommand '#{sub}'")
  end
end

def cmd_wifi(args)
  sub = args.shift or usage(2, "wifi needs scan|status|ensure|connect|hotspot")
  case sub
  when "scan" then out_json("networks" => AirPlayOS::Wifi.scan)
  when "status" then out_json(AirPlayOS::Wifi.status)
  when "ensure"
    need_root!
    AirPlayOS::Log.init("wifi")
    out_json(AirPlayOS::Wifi.ensure)
  when "connect"
    need_root!
    AirPlayOS::Log.init("wifi")
    input = stdin_json
    out_json("ok" => true, "status" => AirPlayOS::Wifi.connect(input["ssid"].to_s, input["psk"].to_s))
  when "hotspot"
    which = args.shift or usage(2, "wifi hotspot needs on|off")
    need_root!
    AirPlayOS::Log.init("wifi")
    changed = case which
              when "on" then AirPlayOS::Wifi.hotspot_on
              when "off" then AirPlayOS::Wifi.hotspot_off
              else usage(2, "wifi hotspot needs on|off")
              end
    out_json("ok" => true, "changed" => changed)
  else usage(2, "unknown wifi subcommand '#{sub}'")
  end
end

def cmd_system(args)
  sub = args.shift or usage(2, "system needs clean-reboot|minimize|config-txt|avahi|ui-secret")
  parse_opts(args) { |o| o.on("--dry-run") { AirPlayOS::Run.dry_run = true } }
  need_root!
  AirPlayOS::Log.init("system")
  case sub
  when "clean-reboot"
    input = stdin_json(required: false)
    AirPlayOS::System.clean_reboot(reset_settings: input["reset_settings"] ? true : false)
    out_json("ok" => true, "rebooting" => true)
  when "minimize" then out_json(AirPlayOS::System.minimize)
  when "config-txt" then out_json(AirPlayOS::System.ensure_config_txt)
  when "avahi" then out_json(AirPlayOS::System.ensure_avahi_ipv4)
  when "ui-secret" then out_json("changed" => AirPlayOS::System.ensure_ui_secret)
  else usage(2, "unknown system subcommand '#{sub}'")
  end
end

def cmd_action(args)
  sub = args.shift or usage(2, "action needs list|run <id>")
  case sub
  when "list" then out_json("actions" => AirPlayOS::Actions.list)
  when "run"
    id = args.shift or usage(2, "action run needs an id")
    need_root!
    AirPlayOS::Log.init("action")
    r = AirPlayOS::Actions.run_action(id, stdin_json(required: false))
    after = r.delete(:after)
    out_json(r)
    after&.call
    r["ok"] ? 0 : 1
  else usage(2, "unknown action subcommand '#{sub}'")
  end
end

# systemd: airplay-os-control@.service (Accept=yes) → STDIN/STDOUT are the client connection
def cmd_control(args)
  sub = args.shift || "handle"
  usage(2, "unknown control subcommand '#{sub}'") unless sub == "handle"
  need_root!
  AirPlayOS::Log.init("control")
  AirPlayOS::Control.handle_stream($stdin, $stdout)
end

def cmd_metadata(args)
  sub = args.shift || "daemon"
  usage(2, "unknown metadata subcommand '#{sub}'") unless sub == "daemon"
  AirPlayOS::Log.init("metadata")
  AirPlayOS::MetadataDaemon.new.run
  0
end

def cmd_log(args)
  sub = args.shift || "aggregate"
  usage(2, "unknown log subcommand '#{sub}'") unless sub == "aggregate"
  need_root!
  AirPlayOS::Log.init("log")
  AirPlayOS::LogAggregator.new.run
  0
end

def cmd_health(args)
  AirPlayOS::Log.init("health")
  s = AirPlayOS::Health.sample
  if args.include?("--json")
    out_json(s)
  else
    AirPlayOS::Log.info(AirPlayOS::Health.line(s))
    s["ok"] ? 0 : 1
  end
end

def cmd_updates(args)
  sub = args.shift || "status"
  AirPlayOS::Log.init("updates")
  case sub
  when "check" then out_json(AirPlayOS::Updates.check)
  when "status" then out_json(AirPlayOS::Updates.status)
  else usage(2, "unknown updates subcommand '#{sub}'")
  end
end

def cmd_redeploy(args)
  sub = args.shift || "status"
  # start|run [--update-shairport VERSION [TAG]]: a shairport-sync release on top of the flake
  update = nil
  if args.first == "--update-shairport"
    args.shift
    version = args.shift or usage(2, "--update-shairport needs a version")
    update = { "version" => version, "tag" => args.shift || version }
  end
  case sub
  when "status" then out_json(AirPlayOS::Redeploy.status)
  when "start"
    need_root!
    AirPlayOS::Log.init("redeploy")
    out_json(AirPlayOS::Redeploy.start(reason: "cli", update: update))
  when "run"
    need_root!
    AirPlayOS::Log.init("redeploy")
    AirPlayOS::Redeploy.run(update: update) ? 0 : 1
  else usage(2, "unknown redeploy subcommand '#{sub}'")
  end
end

COMMANDS = {
  "provision" => method(:cmd_provision), "settings" => method(:cmd_settings),
  "wifi" => method(:cmd_wifi), "system" => method(:cmd_system), "action" => method(:cmd_action),
  "control" => method(:cmd_control), "metadata" => method(:cmd_metadata), "redeploy" => method(:cmd_redeploy), "log" => method(:cmd_log),
  "health" => method(:cmd_health), "updates" => method(:cmd_updates),
  "version" => ->(_a) { puts "airplay-os #{AirPlayOS::VERSION}"; 0 },
  "help" => ->(_a) { usage }
}.freeze

cmd, *rest = ARGV
usage(2) if cmd.nil?
handler = COMMANDS[cmd] or usage(2, "unknown command '#{cmd}'")
begin
  exit(handler.call(rest) || 0)
rescue AirPlayOS::Error, AirPlayOS::Run::CommandError => e
  AirPlayOS::Log.error(e.message) if AirPlayOS::Log.name
  warn "airplay-os #{cmd}: #{e.message}"
  exit 1
end
