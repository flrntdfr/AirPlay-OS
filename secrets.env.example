# Copy to secrets.env (gitignored) and fill in. Read by tools/build-user-data.pl and
# tools/apply-live.sh. Values are injected into the rendered cloud-init files only.
#
# Wi-Fi the device should join (fresh flash). For the in-place switch, apply-live.sh reuses
# the device's current /boot/firmware/network-config byte-for-byte instead.
WIFI_SSID="Pass the Juice"
WIFI_PSK="change-me"   # 8..63 character passphrase, or the 64-digit hex PSK
WIFI_COUNTRY="DE"

# SSH public keys for user pi (one per line inside the quotes). apply-live.sh can harvest the
# device's current ~pi/.ssh/authorized_keys with --harvest.
SSH_AUTHORIZED_KEYS="ssh-ed25519 AAAA... you@host"

# Password hash for user pi (crypt(3) format, e.g. from `getent shadow pi | cut -d: -f2`).
# Keeps the serial console usable for recovery; cloud-init would otherwise lock the account.
# apply-live.sh --harvest fills this from the device.
PI_PASSWORD_HASH=""

# WPA2 passphrase of the onboarding hotspot "AirPlay-OS-setup" (8..63 chars).
SETUP_PSK="airplay-os-setup"

TIMEZONE="Europe/Berlin"
