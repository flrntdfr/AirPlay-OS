# frozen_string_literal: true

source "https://rubygems.org"

# Minimal Rails: no ActiveRecord, no mailers, no Action Cable.
gem "railties", "~> 7.2.3"
gem "actionpack", "~> 7.2.3"
gem "actionview", "~> 7.2.3"
gem "activesupport", "~> 7.2.3"
gem "propshaft", "~> 1.1"
gem "puma", "~> 7.2"

# UI: RubyUI (shadcn/ui port) on Phlex, Tailwind classes merged at render time; Stimulus via
# importmap (no Node at runtime — Tailwind is compiled at Nix build time).
gem "phlex-rails", "~> 2.4"
gem "ruby_ui", "~> 1.6"
gem "tailwind_merge", "~> 1.4"
gem "importmap-rails", "~> 2.1"
gem "stimulus-rails", "~> 1.3"
gem "turbo-rails", "~> 2.0"   # Turbo Frames only (no Drive, no streams): Settings overlay, in-place form submits
