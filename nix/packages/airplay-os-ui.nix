# The Rails web UI, packaged with bundlerEnv (gemset.nix generated by bundix from ui/Gemfile.lock).
# Runs as the unprivileged "airplay-os" user; the only privileged interaction is the control socket.
{
  lib,
  stdenvNoCC,
  ruby_3_4,
  bundlerEnv,
  makeWrapper,
  tailwindcss_4,
  src,
  version,
}:

let
  ruby = ruby_3_4;
  gems = bundlerEnv {
    name = "airplay-os-ui-gems";
    inherit ruby;
    gemdir = ../../ui;
    groups = [ "default" ];
  };
in
stdenvNoCC.mkDerivation {
  pname = "airplay-os-ui";
  inherit version;

  src = lib.cleanSourceWith {
    src = src;
    filter =
      path: _type:
      let
        rel = lib.removePrefix (toString src + "/") (toString path);
        top = builtins.head (lib.splitString "/" rel);
      in
      builtins.elem top [
        "ui"
        "lib"
      ]
      && !(lib.hasSuffix "/tmp" rel)
      && !(lib.hasSuffix "/log" rel);
  };

  nativeBuildInputs = [
    makeWrapper
    tailwindcss_4
  ];
  buildInputs = [
    gems
    ruby
  ];

  # Tailwind (shadcn theme + RubyUI component classes) is compiled here, once; the Pi only serves
  # the resulting file through Propshaft. No Node anywhere.
  buildPhase = ''
    runHook preBuild
    (cd ui && mkdir -p app/assets/builds && tailwindcss -i app/assets/tailwind/application.css -o app/assets/builds/tailwind.css --minify)
    runHook postBuild
  '';

  doCheck = true;
  # Boot the application and render every page at build time (no control socket, no metadata
  # files: the pages must degrade gracefully). Catches load, template and asset errors before the
  # device does.
  checkPhase = ''
    runHook preCheck
    cd ui
    HOME=$TMPDIR RAILS_ENV=production SECRET_KEY_BASE=build-time-check AIRPLAY_OS_LIB=$PWD/../lib \
      AIRPLAY_OS_ACTIONS_FILE=$PWD/../etc/airplay-os/actions.json AIRPLAY_OS_RELEASE_FILE=/nonexistent \
      ${gems}/bin/bundle exec ruby -e '
        require "./config/environment"; require "rack/mock"
        puts "rails #{Rails.version}, phlex #{Phlex::VERSION}"
        pages = {}
        %w[/ /settings /setup /health /api/actions /api/log].each do |p|
          r = Rack::MockRequest.new(Rails.application).get(p, "HTTP_HOST" => "localhost")
          abort "GET #{p} -> #{r.status}\n#{r.body[0, 2000]}" unless r.status == 200
          abort "GET #{p}: layout missing" if p !~ %r{^/(health|api)} && !r.body.include?("log-backdrop")
          pages[p] = r.body
          puts "GET #{p} -> 200 (#{r.body.bytesize} bytes)"
        end
        pages["/settings (frame)"] = Rack::MockRequest.new(Rails.application).get("/settings", "HTTP_HOST" => "localhost", "HTTP_TURBO_FRAME" => "settings").body
        # Every Stimulus controller the pages reference must be pinned in the importmap: a file
        # that exists locally but is not in the (git-filtered) flake source would otherwise ship a
        # page whose buttons do nothing.
        require "json"
        pins = JSON.parse(pages["/"][%r{<script type="importmap"[^>]*>(.*?)</script>}m, 1])["imports"].keys
        used = pages.values.join.scan(/data-controller="([^"]+)"/).flatten.flat_map(&:split).uniq
        missing = used.reject { |id| pins.include?("controllers/#{id.gsub("--", "/").tr("-", "_")}_controller") }
        abort "Stimulus controllers used but not pinned (file untracked?): #{missing.join(", ")}" if missing.any?
        puts "stimulus: #{used.size} controllers referenced, all pinned"'
    cd ..
    runHook postCheck
  '';

  installPhase = ''
    runHook preInstall
    install -d $out/share/airplay-os-ui $out/share/airplay-os-lib $out/bin
    cp -r ui/. $out/share/airplay-os-ui/
    cp -r lib/. $out/share/airplay-os-lib/
    rm -rf $out/share/airplay-os-ui/{tmp,log}
    # Puma, production, port from $PORT (80 via CAP_NET_BIND_SERVICE in the unit).
    makeWrapper ${gems}/bin/bundle $out/bin/airplay-os-ui \
      --add-flags "exec puma -C $out/share/airplay-os-ui/config/puma.rb $out/share/airplay-os-ui/config.ru" \
      --set BUNDLE_GEMFILE $out/share/airplay-os-ui/Gemfile \
      --set AIRPLAY_OS_LIB $out/share/airplay-os-lib \
      --set-default RAILS_ENV production \
      --set-default RAILS_LOG_TO_STDOUT 1 \
      --chdir $out/share/airplay-os-ui
    runHook postInstall
  '';

  meta = {
    description = "AirPlay OS web UI (Rails): now playing, settings, Wi-Fi onboarding, control API";
    license = lib.licenses.mit;
    platforms = lib.platforms.unix;
    mainProgram = "airplay-os-ui";
  };
}
